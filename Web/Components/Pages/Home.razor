@page "/"

<PageTitle>Home</PageTitle>

@* link to sample page *@
<a href="/sample">View Sample Page</a>
<div>@yourErrorVariableGoesHere</div>
@* br's for extra spacing *@
<br>
<br>
<br>


@if (road == null)
{
    <div>
        <h3>Create Road</h3>
        <div>
            Rows: <input @bind="userRequestRows" />
        </div>
        <div>
            Columns: <input @bind="userRequestColumns" />
        </div>
        <button @onclick="CreateRoad">Create Road</button>
    </div>
}
else
{
    <table>
        @for (int row = 0; row < road.RowCount; row++)
        {
            <tr>
                @for (int col = 0; col < road.ColCount; col++)
                {
                    <td>
                        @if (road.GetVehicle(row, col) != null)
                        {
                            <img src="@road.GetVehicle(row, col)?.GetImagePath()" height="100" />
                        }
                    </td>
                }
            </tr>
        }
    </table>

    <div>
        <h3>Set a Vehicle</h3>
        <div>
            Row: <input @bind="vehicleRowInput" />
        </div>
        <div>
            Column: <input @bind="vehicleColumnInput" />
        </div>
        <button @onclick=@(() => SetVehicle("Car"))>Set Car</button>
        <button @onclick=@(() => SetVehicle("Bus"))>Set Bus</button>
        <button @onclick=@(() => SetVehicle("FireTruck"))>Set FireTruck</button>
        <button @onclick=@(() => SetVehicle("Taxi"))>Set Taxi</button>
    </div>
}





@code
{
    private string? userRequestRows;
    private string? userRequestColumns;
    private IRoad? road = null;
    private string? yourErrorVariableGoesHere;
    private string? vehicleRowInput;
    private string? vehicleColumnInput;

    private void CreateRoad()
    {
        if (int.TryParse(userRequestRows, out int rows) && int.TryParse(userRequestColumns, out int columns))
        {
            road = new Road(rows, columns);
            yourErrorVariableGoesHere = string.Empty;
        }
        else
        {
            yourErrorVariableGoesHere = "Please, enter valid numbers for rows and columns, try again...";
        }
    }

    private void SetVehicle(string vehicleType)
    {
        if (int.TryParse(vehicleRowInput, out int row) && int.TryParse(vehicleColumnInput, out int column))
        {
            IVehicle vehicle = vehicleType switch
            {
                "Car" => new Car(),
                "Bus" => new Bus(),
                "FireTruck" => new FireTruck(),
                "Taxi" => new Taxi(),
                _ => null
            };

            if (vehicle != null)
            {
                road.SetVehicle(row, column, vehicle);
                yourErrorVariableGoesHere = string.Empty;
            }
        }
        else
        {
            yourErrorVariableGoesHere = "Please, enter valid numbers for rows and columns, try again...";
        }
    }
}